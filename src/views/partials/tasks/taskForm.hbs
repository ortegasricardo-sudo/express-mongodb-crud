<div class="card card-body p-4 rounded-0 bg-dark text-white">
  
  <form action="/task/add" method="post">
<h1>Add a Task</h1>
  <div>
    <label for="title">Write a title:</label>
    <input type="text" name="title" placeholder="Title"  class="form-control rounded-0 bg-dark text-white"/>
  </div>

  <div>
    <label for="description">description</label>
    <textarea
      name="description"
      placeholder="Description"
      id="description"
    class="form-control rounded-0 bg-dark text-white"></textarea>
  </div>

  <button class="btn btn-primary btn-sm mt-2">Add</button>

</form>
</div>